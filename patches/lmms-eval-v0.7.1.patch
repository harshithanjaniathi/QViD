diff --git a/lmms_eval/tasks/mmbench/en_utils.py b/lmms_eval/tasks/mmbench/en_utils.py
index 67546f2..45744e0 100755
--- a/lmms_eval/tasks/mmbench/en_utils.py
+++ b/lmms_eval/tasks/mmbench/en_utils.py
@@ -108,7 +108,61 @@ def mmbench_process_results(doc, results):
 
 def mmbench_aggregate_dev_results_eval(results, args):
     print("============= MMBench-EN(Dev) Detailed Results =============")
-    overall_acc, category_acc, l2_category_acc = mmbench_evaluator.eval_result(results, eval_method="openai")
+    # Always use local circular accuracy (matches the official MMBench metric).
+    # Circular eval groups question variants by index % 1e6 and requires ALL variants
+    # to be answered correctly for a question to count as correct.
+    import string as _string
+    import pandas as _pd
+
+    def _can_infer(answer, row):
+        answer = str(answer).strip()
+        valid = [c for c in _string.ascii_uppercase[:5]
+                 if str(row.get(c, "nan")) not in ("nan", "", "None")]
+        if not valid:
+            valid = list(_string.ascii_uppercase[:4])
+        if answer in valid:
+            return answer
+        splits = answer.split()
+        for c in valid:
+            if c in splits or f"({c})" in splits or f"{c}." in splits:
+                return c
+        if splits and splits[0].rstrip(".()") in valid:
+            return splits[0].rstrip(".()")
+        answer_lower = answer.lower()
+        for c in valid:
+            v = str(row.get(c, ""))
+            if v not in ("nan", "", "None") and v.lower() in answer_lower:
+                return c
+        return None
+
+    data = _pd.DataFrame(results).sort_values(by="index")
+    answer_map = dict(zip(data["index"], data["answer"]))
+    cate_map = dict(zip(data["index"], data["category"]))
+    data_main = data[data["index"] < int(1e6)]
+
+    hit = tot = 0
+    cat_hit: dict = {}
+    cat_tot: dict = {}
+    for _, row in data_main.iterrows():
+        idx = row["index"]
+        cat = str(cate_map.get(idx, "other"))
+        sub_data = data[data["index"] % int(1e6) == idx]
+        group_hit = 1
+        for _, srow in sub_data.iterrows():
+            gt = str(answer_map[srow["index"]])
+            pred = _can_infer(str(srow.get("prediction", "")), srow)
+            if pred is None or pred != gt:
+                group_hit = 0
+                break
+        hit += group_hit; tot += 1
+        cat_hit[cat] = cat_hit.get(cat, 0) + group_hit
+        cat_tot[cat] = cat_tot.get(cat, 0) + 1
+
+    overall_acc = hit / tot if tot else 0.0
+    category_acc = {c: cat_hit[c] / cat_tot[c] for c in cat_tot}
+    l2_category_acc = {}
+    eval_logger.info(f"MMBench circular scoring: {hit}/{tot} = {overall_acc*100:.2f}%")
+
     file = generate_submission_file("mmbench_en_dev_results.json", args)
     details_info = {
         "overall_acc": overall_acc,
